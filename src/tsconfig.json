{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vscode"],
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "shared/**/*.ts", "webview/**/*.mts", "webview/**/*.tsx", "scripts/**/*.ts", "test/**/*.ts"]
}
